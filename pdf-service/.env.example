# Các biến môi trường tùy chọn cho pdf-service khi chạy KHÔNG dùng Docker.
# File này chỉ để tham khảo — main.py đọc os.getenv() trực tiếp, KHÔNG tự
# nạp file .env. Nếu muốn dùng thật, export các biến này trước khi chạy
# uvicorn, hoặc cài thêm `python-dotenv` và load ở đầu main.py.

# Thư mục lưu file PDF gốc đã upload (mặc định: ./data/uploads, tự tạo nếu chưa có)
UPLOAD_DIR=./data/uploads

# Thư mục lưu FAISS index + metadata chunk (mặc định: ./data/faiss)
FAISS_DIR=./data/faiss

# Model embedding từ sentence-transformers (mặc định: all-MiniLM-L6-v2, ~90MB,
# tự tải về lần chạy đầu tiên)
EMBEDDING_MODEL=all-MiniLM-L6-v2
